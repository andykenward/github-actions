// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Container - Github Actions",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"eamodio.gitlens",
				"redhat.vscode-yaml"
			]
		}
	},
	"postCreateCommand": {
		"post-create": "devcontainer-post-create && mise exec -- pnpm i"
	},
	"containerEnv": {
		"DEVCONTAINER_STARSHIP_CONFIG": "${containerWorkspaceFolder}/.devcontainer/starship.toml"
	},
	"mounts": [
		"source=devcontainer-claude,target=/home/vscode/.claude,type=volume",
		"source=devcontainer-gh,target=/home/vscode/.config/gh,type=volume",
		"source=devcontainer-git,target=/home/vscode/.config/git,type=volume",
		"source=${devcontainerId}-mise,target=/home/vscode/.local/share/mise,type=volume",
		"source=${devcontainerId}-history,target=/commandhistory,type=volume",
		"source=${devcontainerId}-vscode-extensions,target=/home/vscode/.vscode-server/extensions,type=volume"
	]
}